# Railway Environment Variables Template
# Copy this to Railway's environment variables section

# Server Configuration
NODE_ENV=production
PORT=5000

# Database Configuration (Railway will provide these automatically)
# DATABASE_URL=postgresql://username:password@host:port/database
# PGHOST=host
# PGPORT=5432
# PGUSER=username
# PGPASSWORD=password
# PGDATABASE=database

# Admin Authentication (Optional - leave empty for no-auth mode)
ADMIN_USER=admin
ADMIN_PASSWORD=your-secure-password

# React App Configuration (Optional)
REACT_APP_BASE_URL=
REACT_APP_AUTH_TOKEN=

# Security (Railway will set these automatically)
# RAILWAY_ENVIRONMENT=production
# RAILWAY_PROJECT_ID=
# RAILWAY_SERVICE_ID=
